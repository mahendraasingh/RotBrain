<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- Circular Brain Mascot Bubble -->
    <FrameLayout
        android:id="@+id/fl_brain_circle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bg_brain_circle"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/iv_brain_mascot"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_brain_fresh"
            android:scaleType="centerCrop"
            android:contentDescription="Brain Mascot" />

    </FrameLayout>

    <!-- Overlapping Circular Count Badge at Bottom Center -->
    <TextView
        android:id="@+id/tv_brain_count"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_centerHorizontal="true"
        android:layout_alignBottom="@id/fl_brain_circle"
        android:layout_marginBottom="-10dp"
        android:background="@drawable/bg_count_badge"
        android:elevation="8dp"
        android:gravity="center"
        android:textColor="#3E1F0A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="0" />

</RelativeLayout>
